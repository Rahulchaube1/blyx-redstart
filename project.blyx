use std::cli;
use console;
use redstart;

fn main() {
    let argv = cli_args();
    let count = args_len(argv);
    if count == 1 && args_at(argv, 0) == "--help" {
        println!("Update a binary-event model and report uncertainty in its probability.");
        println!("Usage: redstart alpha beta positive negative");
        println!("Vector arguments are comma-separated; use [] for an empty vector.");
        return;
    }
    let mut result = [];
    if count == 0 {
        result = redstart_posterior(1.0, 1.0, 1.0, 1.0);
    } else {
        if count != 4 { stderr_line("Wrong argument count. Use --help."); process_exit(2); }
        let alpha = console_value(args_at(argv, 0));
        let beta = console_value(args_at(argv, 1));
        let positive = console_value(args_at(argv, 2));
        let negative = console_value(args_at(argv, 3));
        result = redstart_posterior(alpha, beta, positive, negative);
    }
    if len(result) == 0 { stderr_line("Invalid input for Redstart. See the package input contract."); process_exit(1); }
    let mut i = 0;
    while i < len(result) {
        println!(at(result, i));
        i += 1;
    }
}
